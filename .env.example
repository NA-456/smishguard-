# SmishGuard environment variables
# Copy this file to .env and fill in your values

# General
ENVIRONMENT=production
DEBUG=false
ALLOWED_ORIGINS=https://yourdomain.com

# API Key Authentication (comma-separated; leave empty to disable auth in dev)
SMISHGUARD_API_KEYS=your-secret-key-here,another-key-if-needed

# Admin API token (change this!)
SMISHGUARD_ADMIN_TOKEN=change-me-to-a-strong-secret

# AfricasTalking
AT_USERNAME=sandbox
AT_API_KEY=
AT_SHORTCODE=
AT_WEBHOOK_SECRET=

# Detection thresholds
DANGER_THRESHOLD=55
SUSPICIOUS_THRESHOLD=25

# Auto-reply
ENABLE_AUTO_REPLY=false
